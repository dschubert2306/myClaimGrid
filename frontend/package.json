{
  "name": "@myclaimgrid/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "start": "npm run tokens && ng serve",
    "start:e2e": "npm run tokens && ng serve --configuration e2e --port 4300",
    "build": "npm run tokens && ng build",
    "build:e2e": "npm run tokens && ng build --configuration e2e",
    "typecheck": "npm run tokens && ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "csp:check": "node scripts/csp-hash.mjs --check",
    "csp:write": "node scripts/csp-hash.mjs --write"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@myclaimgrid/shared": "*",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@playwright/test": "^1.65.0"
  }
}
