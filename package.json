{
  "name": "myclaimgrid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "infra"
  ],
  "scripts": {
    "build": "npm run build -w shared && npm run build --workspaces --if-present",
    "typecheck": "npm run build -w shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build -w shared && npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "synth": "npm run synth -w infra",
    "csp:check": "npm run csp:check --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.0"
  }
}
